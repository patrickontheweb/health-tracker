{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "health-habits": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/health-habits"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "assets": [
                {
                  "ignore": [
                    "config.json"
                  ],
                  "input": "public",
                  "glob": "**/*"
                },
                {
                  "input": "local-public",
                  "glob": "config.json"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "health-habits:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
